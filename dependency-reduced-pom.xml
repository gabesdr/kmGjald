<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>is</groupId>
  <artifactId>vidmot</artifactId>
  <name>kmGjald</name>
  <version>1.0-SNAPSHOT</version>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.3.2</version>
        <configuration>
          <failOnError>false</failOnError>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${java.version}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <executions>
          <execution>
            <id>default-cli</id>
            <configuration>
              <jlinkZipName>runtime-image</jlinkZipName>
            </configuration>
          </execution>
          <execution>
            <id>build-runtime-image</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>jlink</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <mainClass>${app.moduleMainClass}</mainClass>
          <launcher>${app.name}</launcher>
          <jlinkImageName>runtime-image</jlinkImageName>
          <noManPages>true</noManPages>
          <stripDebug>true</stripDebug>
          <noHeaderFiles>true</noHeaderFiles>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.gluonhq</groupId>
        <artifactId>gluonfx-maven-plugin</artifactId>
        <version>${gluonfx.version}</version>
        <configuration>
          <target>${gluonfx.target}</target>
          <mainClass>${app.mainClass}</mainClass>
          <appIdentifier>is.vidmot.kmgjald</appIdentifier>
          <releaseConfiguration>
            <vendor>Gabriel del Rosario</vendor>
            <description>Kilometragjald calculator</description>
            <appLabel>${app.name}</appLabel>
            <versionName>${app.version}</versionName>
            <versionCode>1</versionCode>
          </releaseConfiguration>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>desktop</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>package-windows-artifacts</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>powershell</executable>
                  <arguments>
                    <argument>-NoProfile</argument>
                    <argument>-ExecutionPolicy</argument>
                    <argument>Bypass</argument>
                    <argument>-File</argument>
                    <argument>C:\Coding Hub\Java\HBV\kmGjald\scripts\package-windows.ps1</argument>
                    <argument>-ProjectDir</argument>
                    <argument>C:\Coding Hub\Java\HBV\kmGjald</argument>
                    <argument>-TargetDir</argument>
                    <argument>C:\Coding Hub\Java\HBV\kmGjald\target</argument>
                    <argument>-RuntimeImageDir</argument>
                    <argument>C:\Coding Hub\Java\HBV\kmGjald\target\runtime-image</argument>
                    <argument>-InputDir</argument>
                    <argument>C:\Coding Hub\Java\HBV\kmGjald\target</argument>
                    <argument>-MainJar</argument>
                    <argument>vidmot-1.0-SNAPSHOT.jar</argument>
                    <argument>-MainClass</argument>
                    <argument>is.vidmot.kmGjaldApp</argument>
                    <argument>-AppName</argument>
                    <argument>KmGjaldReiknivel</argument>
                    <argument>-AppVersion</argument>
                    <argument>1.0</argument>
                    <argument>-IconPath</argument>
                    <argument>C:\Coding Hub\Java\HBV\kmGjald\src\main\resources\is\vidmot\icon.ico</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-shade-plugin</artifactId>
            <version>3.5.1</version>
            <executions>
              <execution>
                <phase>package</phase>
                <goals>
                  <goal>shade</goal>
                </goals>
                <configuration>
                  <transformers>
                    <transformer>
                      <mainClass>is.vidmot.kmGjaldApp</mainClass>
                    </transformer>
                  </transformers>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <properties>
        <gluonfx.target>host</gluonfx.target>
      </properties>
    </profile>
    <profile>
      <id>android</id>
      <properties>
        <javafx.platform>linux</javafx.platform>
        <gluonfx.target>android</gluonfx.target>
      </properties>
    </profile>
    <profile>
      <id>javafx-windows</id>
      <properties>
        <javafx.platform>win</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>javafx-linux</id>
      <properties>
        <javafx.platform>linux</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>javafx-macos</id>
      <properties>
        <javafx.platform>mac</javafx.platform>
      </properties>
    </profile>
  </profiles>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.12.1</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>opentest4j</artifactId>
          <groupId>org.opentest4j</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-platform-commons</artifactId>
          <groupId>org.junit.platform</groupId>
        </exclusion>
        <exclusion>
          <artifactId>apiguardian-api</artifactId>
          <groupId>org.apiguardian</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>5.12.1</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>junit-platform-engine</artifactId>
          <groupId>org.junit.platform</groupId>
        </exclusion>
        <exclusion>
          <artifactId>apiguardian-api</artifactId>
          <groupId>org.apiguardian</groupId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
  <properties>
    <javafx.platform>win</javafx.platform>
    <gluonfx.version>1.0.27</gluonfx.version>
    <java.version>21</java.version>
    <gluonfx.target>host</gluonfx.target>
    <app.moduleMainClass>is.vidmot/is.vidmot.kmGjaldApp</app.moduleMainClass>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.6</javafx.version>
    <junit.version>5.12.1</junit.version>
    <app.mainClass>is.vidmot.kmGjaldApp</app.mainClass>
    <app.name>KmGjaldReiknivel</app.name>
    <app.version>1.0</app.version>
  </properties>
</project>
