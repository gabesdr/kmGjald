<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>is</groupId>
    <artifactId>vidmot</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>kmGjald</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>21</java.version>
        <javafx.version>21.0.6</javafx.version>
        <javafx.platform>win</javafx.platform>
        <gluonfx.version>1.0.27</gluonfx.version>
        <gluonfx.target>host</gluonfx.target>
        <junit.version>5.12.1</junit.version>
        <app.name>KmGjaldReiknivel</app.name>
        <app.version>1.0</app.version>
        <app.mainClass>is.vidmot.kmGjaldApp</app.mainClass>
        <app.moduleMainClass>is.vidmot/is.vidmot.kmGjaldApp</app.moduleMainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.3.2</version>
                <configuration>
                    <failOnError>false</failOnError>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${app.moduleMainClass}</mainClass>
                    <launcher>${app.name}</launcher>
                    <jlinkImageName>runtime-image</jlinkImageName>
                    <noManPages>true</noManPages>
                    <stripDebug>true</stripDebug>
                    <noHeaderFiles>true</noHeaderFiles>
                </configuration>
                <executions>
                    <execution>
                        <id>default-cli</id>
                        <configuration>
                            <jlinkZipName>runtime-image</jlinkZipName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>build-runtime-image</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>jlink</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.gluonhq</groupId>
                <artifactId>gluonfx-maven-plugin</artifactId>
                <version>${gluonfx.version}</version>
                <configuration>
                    <target>${gluonfx.target}</target>
                    <mainClass>${app.mainClass}</mainClass>
                    <appIdentifier>is.vidmot.kmgjald</appIdentifier>
                    <releaseConfiguration>
                        <vendor>Gabriel del Rosario</vendor>
                        <description>Kilometragjald calculator</description>
                        <appLabel>${app.name}</appLabel>
                        <versionName>${app.version}</versionName>
                        <versionCode>1</versionCode>
                    </releaseConfiguration>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>desktop</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <gluonfx.target>host</gluonfx.target>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>package-windows-artifacts</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>powershell</executable>
                                    <arguments>
                                        <argument>-NoProfile</argument>
                                        <argument>-ExecutionPolicy</argument>
                                        <argument>Bypass</argument>
                                        <argument>-File</argument>
                                        <argument>${project.basedir}\scripts\package-windows.ps1</argument>
                                        <argument>-ProjectDir</argument>
                                        <argument>${project.basedir}</argument>
                                        <argument>-TargetDir</argument>
                                        <argument>${project.build.directory}</argument>
                                        <argument>-RuntimeImageDir</argument>
                                        <argument>${project.build.directory}\runtime-image</argument>
                                        <argument>-InputDir</argument>
                                        <argument>${project.build.directory}</argument>
                                        <argument>-MainJar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>-MainClass</argument>
                                        <argument>${app.mainClass}</argument>
                                        <argument>-AppName</argument>
                                        <argument>${app.name}</argument>
                                        <argument>-AppVersion</argument>
                                        <argument>${app.version}</argument>
                                        <argument>-IconPath</argument>
                                        <argument>${project.basedir}\src\main\resources\is\vidmot\icon.ico</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.5.1</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>${app.mainClass}</mainClass>
                                        </transformer>
                                    </transformers>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>android</id>
            <properties>
                <gluonfx.target>android</gluonfx.target>
                <javafx.platform>linux</javafx.platform>
            </properties>
        </profile>

        <profile>
            <id>javafx-windows</id>
            <activation>
                <os>
                    <family>Windows</family>
                </os>
            </activation>
            <properties>
                <javafx.platform>win</javafx.platform>
            </properties>
        </profile>

        <profile>
            <id>javafx-linux</id>
            <activation>
                <os>
                    <name>Linux</name>
                </os>
            </activation>
            <properties>
                <javafx.platform>linux</javafx.platform>
            </properties>
        </profile>

        <profile>
            <id>javafx-macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <javafx.platform>mac</javafx.platform>
            </properties>
        </profile>
    </profiles>
</project>
